#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX 200

int precedence(char op)
{
    if (op == '*' || op == '/')
        return 2;

    if (op == '+' || op == '-')
        return 1;

    return 0;
}

void infixToPostfix(char infix[], char postfix[])
{
    char stack[MAX];
    int top = -1;
    int i = 0, j = 0;

    while (infix[i] != '\0')
    {
        char ch = infix[i];

        if (isspace(ch))
        {
            i++;
            continue;
        }

        if(isdigit(ch))
        {
            while (isdigit(infix[i]))
                postfix[j++] = infix[i++];

            postfix[j++] = ' ';
        }
        else if (ch == '(')
        {
            stack[++top] = ch;
            i++;
        }
        else if (ch == ')')
        {
            while (top != -1 && stack[top] != '(')
            {
                postfix[j++] = stack[top--];
                postfix[j++] = ' ';
            }

            top--;
            i++;
        }
        else
        {
            while (top != -1 &&
                   stack[top] != '(' &&
                   precedence(stack[top]) >= precedence(ch))
            {
                postfix[j++] = stack[top--];
                postfix[j++] = ' ';
            }

            stack[++top] = ch;
            i++;
        }
    }

    while (top != -1)
    {
        postfix[j++] = stack[top--];
        postfix[j++] = ' ';
    }

    postfix[j] = '\0';
}

long long evaluatePostfix(char postfix[])
{
    long long stack[MAX];
    int top = -1;
    int i = 0;

    while (postfix[i] != '\0')
    {
        if (isspace(postfix[i]))
        {
            i++;
            continue;
        }

        if (isdigit(postfix[i]))
        {
            long long num = 0;

            while (isdigit(postfix[i]))
            {
                num = num * 10 + (postfix[i] - '0');
                i++;
            }

            stack[++top] = num;
        }
        else
        {
            long long b = stack[top--];
            long long a = stack[top--];

            if (postfix[i] == '+')
                stack[++top] = a + b;
            else if (postfix[i] == '-')
                stack[++top] = a - b;
            else if (postfix[i] == '*')
                stack[++top] = a * b;
            else if (postfix[i] == '/')
                stack[++top] = a / b;

            i++;
        }
    }

    return stack[top];
}

int main(int argc, char *argv[])
{
    char postfix[MAX];

    if (argc != 2)
    {
        printf("Error: Please enter an expression.\n");
        return 1;
    }

    infixToPostfix(argv[1], postfix);

    printf("%lld\n", evaluatePostfix(postfix));

    return 0;
}
